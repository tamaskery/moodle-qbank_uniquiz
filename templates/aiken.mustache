<div id="qbank-uniquiz" data-config="{{config}}"><div class="aiken-shell">
    <section class="aiken-hero" aria-labelledby="aiken-title">
      <p class="eyebrow">{{lang.ui_uniquiz_v0_7_0_browser_only_utility}}</p>
      <h1 id="aiken-title">{{lang.ui_aiken}} <span>{{lang.ui_fixer}}</span></h1>
      <p class="aiken-tagline">{{lang.ui_fix_common_moodle_aiken_formatting_problems}}</p>
      <p>{{lang.ui_upload_or_paste_your_aiken_questions_uniquiz_che}}</p>
    </section>

    <div id="aiken-status" class="sr-only" role="status" aria-live="polite"></div>
    <div id="aiken-error" class="notice notice-error" role="alert" tabindex="-1" hidden></div>

    <section class="aiken-card" aria-labelledby="input-title">
      <div class="section-heading"><div><p class="step-kicker">{{lang.ui_input}}</p><h2 id="input-title">{{lang.ui_upload_or_paste_aiken}}</h2></div><span class="privacy-pill">{{lang.ui_browser_only}}</span></div>
      <div class="aiken-input-grid">
        <div id="aiken-drop-zone" class="aiken-upload">
          <input id="aiken-file" type="file" accept=".txt,text/plain" class="sr-only" tabindex="-1" aria-hidden="true">
          <div class="upload-icon" aria-hidden="true">↥</div>
          <h3>{{lang.ui_upload_aiken}}</h3>
          <p>{{lang.ui_choose_a_utf_8}} <code>.txt</code> {{lang.ui_file_up_to_5_mb}}</p>
          <button id="aiken-choose" class="button button-secondary" type="button">{{lang.ui_choose_aiken_file}}</button>
          <p id="aiken-selected" class="selected-file" hidden></p>
          <p id="aiken-drop-help" class="drop-help">{{lang.ui_or_drop_an_aiken_file_here}}</p>
        </div>
        <div class="aiken-paste">
          <label for="aiken-source"><strong>{{lang.ui_paste_aiken}}</strong><span>{{lang.ui_paste_one_or_more_complete_questions}}</span></label>
          <textarea id="aiken-source" dir="auto" rows="14" spellcheck="false" placeholder="{{lang.ui_what_is_the_capital_of_hungary_a_vienna_b_budape}}"></textarea>
        </div>
      </div>
      <p class="microcopy">{{lang.ui_question_content_remains_in_this_browser_tab_it_}}</p>
      <div class="actions actions-end"><button id="check-aiken" class="button button-primary button-arrow" type="button">{{lang.ui_check_aiken}} <span aria-hidden="true">→</span></button></div>
    </section>

    <section id="aiken-results" class="aiken-card" aria-labelledby="results-title" hidden>
      <div class="section-heading"><div><p class="step-kicker">{{lang.ui_analysis}}</p><h2 id="results-title">{{lang.ui_here_s_what_we_found}}</h2></div><span class="success-badge">{{lang.ui_utf_8}}</span></div>
      <div id="aiken-metrics" class="metric-grid aiken-metrics"></div>
      <div id="aiken-issues" class="aiken-issues"></div>
      <div class="actions aiken-fix-actions">
        <button id="fix-safe" class="button button-primary" type="button">{{lang.ui_fix_all_safe_issues}}</button>
        <button id="reset-aiken" class="button button-ghost" type="button">{{lang.ui_reset_to_original}}</button>
      </div>

      <div class="aiken-editor-heading"><div><h3>{{lang.ui_corrected_aiken}}</h3><p>{{lang.ui_you_can_edit_the_text_directly_uniquiz_reparses_}}</p></div><span id="editor-state"></span></div>
      <textarea id="aiken-corrected" class="aiken-editor" dir="auto" rows="20" spellcheck="false" aria-label="{{lang.ui_corrected_aiken_text}}"></textarea>
      <div id="aiken-validation" class="notice" role="status"></div>
      <div class="actions aiken-download-actions">
        <a class="text-link" href="{{converterurl}}">{{lang.ui_need_moodle_xml_open_uniquiz_converter}}</a>
        <a href="#" id="download-aiken" class="button button-primary button-download" download>{{lang.ui_download_corrected_aiken}}</a>
      </div>
    </section>
  </div>  <div id="aiken-processing" class="processing" role="status" aria-live="polite" aria-label="{{lang.ui_checking_aiken}}" hidden><div class="processing-art" aria-hidden="true"><div class="rainbow-trail"></div><div class="mini-unicorn">🦄</div><div class="spark one">✦</div><div class="spark two">✧</div></div><strong>{{lang.ui_checking_aiken_structure}}</strong><span>{{lang.ui_this_happens_privately_in_your_browser}}</span></div></div>
